{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://osef.dev/schema/entities/12-knowledge.schema.json",

  "title": "OSEF Knowledge",

  "description": "Schema defining a reusable knowledge asset within OSEF.",

  "type": "object",

  "required": [
    "metadata",
    "knowledge"
  ],

  "properties": {

    "metadata": {
      "$ref": "../core/01-metadata.schema.json"
    },

    "knowledge": {

      "type": "object",

      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "description",
        "category",
        "status",
        "source",
        "owner",
        "version"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },

        "name": {
          "type": "string",
          "minLength": 3
        },

        "description": {
          "type": "string"
        },

        "category": {
          "type": "string",
          "enum": [
            "lesson",
            "best-practice",
            "pattern",
            "guideline",
            "standard",
            "decision",
            "research",
            "reference",
            "documentation",
            "other"
          ]
        },

        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "deprecated",
            "archived"
          ]
        },

        "source": {
          "type": "string"
        },

        "owner": {
          "type": "string"
        },

        "version": {
          "type": "string"
        },

        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true
        },

        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true
        },

        "validation": {

          "type": "object",

          "additionalProperties": false,

          "properties": {

            "validated": {
              "type": "boolean",
              "default": false
            },

            "validated_by": {
              "type": "string"
            },

            "validation_date": {
              "type": "string",
              "format": "date"
            }

          }

        }

      }

    }

  },

  "additionalProperties": false
}
