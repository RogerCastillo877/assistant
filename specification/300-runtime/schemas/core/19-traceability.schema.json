{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://osef.dev/schema/core/19-traceability.schema.json",
"title": "OSEF Traceability",
"description": "Defines traceability relationships between engineering artifacts within OSEF.",
"type": "object",
"required": [
"id",
"source",
"target",
"relationship"
],
"properties": {
"id": {
"type": "string",
"description": "Unique traceability relationship identifier.",
"pattern": "^[A-Za-z0-9-]+$"
},
"source": {
"type": "string",
"description": "Identifier of the originating artifact.",
"minLength": 1
},
"target": {
"type": "string",
"description": "Identifier of the related artifact.",
"minLength": 1
},
"relationship": {
"type": "string",
"enum": [
"implements",
"defines",
"requires",
"depends_on",
"references",
"extends",
"specializes",
"validates",
"governs",
"produces",
"consumes",
"uses",
"generates",
"documents",
"supersedes"
]
},
"description": {
"type": "string"
},
"status": {
"type": "string",
"enum": [
"active",
"deprecated",
"obsolete"
],
"default": "active"
},
"created": {
"type": "string",
"format": "date"
},
"owner": {
"type": "string"
},
"confidence": {
"type": "number",
"minimum": 0,
"maximum": 1,
"default": 1.0
},
"metadata": {
"type": "object",
"additionalProperties": true
}
},
"additionalProperties": false
}
